# Copy to .env and fill in. Only EXPO_PUBLIC_* values are bundled into the app;
# they are publishable by design. Never put a service-role key or any
# provider key here.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
EXPO_PUBLIC_MUSIC_SERVICE_URL=http://localhost:8787
EXPO_PUBLIC_APP_ENV=development
